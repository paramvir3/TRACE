# Source-matched R1 WTMetaD-IB sampling variables for the released C,F,Cl,H,H,H order.
# ASE-compatible units: input distances in A, energies in eV, and time in ASE units.
UNITS LENGTH=A TIME=0.010180505671156723 ENERGY=96.48533288249877
r_f: DISTANCE ATOMS=1,2
r_cl: DISTANCE ATOMS=1,3
avg_r: COMBINE ARG=r_f,r_cl COEFFICIENTS=0.5,0.5 PERIODIC=NO
avg_wall: UPPER_WALLS ARG=avg_r AT=2.5 KAPPA=1000.0 EXP=2
diff_r: COMBINE ARG=r_cl,r_f COEFFICIENTS=1.0,-1.0 PERIODIC=NO
metad: METAD ARG=diff_r PACE=20 HEIGHT=0.12925995505825819 SIGMA=0.05 TEMP=300.0 BIASFACTOR=100 FILE=HILLS
PRINT ARG=r_f,r_cl,avg_r,diff_r,avg_wall.bias,metad.bias STRIDE=20 FILE=COLVAR
